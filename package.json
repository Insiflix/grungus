{
  "name": "grungus-matrix",
  "version": "0.1.7-beta",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/Insiflix/grungus-frontend.git"
  },
  "overrides": {
    "@electron/get": {
      "global-agent": "^4.1.3"
    }
  },
  "description": "A secure, extensible Matrix desktop client proof of concept",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"npm:dev:electron\"",
    "dev:electron": "tsc -p tsconfig.electron.json && concurrently -k \"tsc -p tsconfig.electron.json --watch --preserveWatchOutput\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 node scripts/start-electron.mjs\"",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:notification": "tsc -p tsconfig.electron.json && node scripts/test-notification.cjs",
    "test:typing": "node scripts/test-typing-performance.mjs",
    "test:pickers": "node scripts/test-picker-performance.mjs",
    "test:avatars": "node scripts/test-avatar-editor.mjs",
    "test:chat": "tsc -p tsconfig.electron.json && node scripts/test-chat-interactions.mjs",
    "test:spaces": "node scripts/test-space-navigation.mjs",
    "test:media": "tsc -p tsconfig.electron.json && node scripts/test-media-playback.mjs",
    "build:app": "npm run typecheck && vite build && tsc -p tsconfig.electron.json",
    "build": "npm run build:app && electron-builder --publish never",
    "build:dir": "npm run typecheck && vite build && tsc -p tsconfig.electron.json && electron-builder --dir",
    "test:microphone": "node scripts/test-microphone.mjs",
    "test:call": "node scripts/smoke-element-call.mjs",
    "test:security": "vite build && tsc -p tsconfig.electron.json && node scripts/test-packaged-security.mjs",
    "icons": "node scripts/generate-icons.cjs"
  },
  "build": {
    "appId": "dev.grungus.matrix",
    "productName": "Grungus",
    "publish": {
      "provider": "github",
      "owner": "Insiflix",
      "repo": "grungus-frontend",
      "private": false
    },
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json"
    ],
    "protocols": [
      {
        "name": "Grungus Matrix authentication",
        "schemes": [
          "grungus-matrix"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "artifactName": "Grungus-${version}-windows-setup.${ext}",
      "icon": "public/grungus.ico"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "public/grungus.png",
      "category": "Network",
      "artifactName": "Grungus-${version}-linux-${arch}.${ext}"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.social-networking",
      "icon": "public/grungus.png"
    }
  },
  "dependencies": {
    "@element-hq/element-call-embedded": "^0.28.0",
    "@emoji-mart/data": "^1.2.1",
    "@ffmpeg/core": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@matrix-org/matrix-sdk-crypto-wasm": "^18.8.0",
    "@sapphi-red/web-noise-suppressor": "^0.4.1",
    "@tanstack/react-query": "^5.102.8",
    "axios": "^1.20.0",
    "electron-updater": "^6.8.9",
    "linkify-it": "^6.1.0",
    "lucide-react": "^1.41.0",
    "matrix-js-sdk": "^42.3.0",
    "matrix-widget-api": "^1.19.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "ffmpeg-static": "^5.3.0",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0",
    "wait-on": "^9.1.0"
  }
}
